{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "atelier status # atelier-managed:SessionStart",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "atelier check || exit 1 # atelier-managed:Stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
