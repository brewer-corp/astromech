{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "astromech",
  "version": "0.1.5",
  "identifier": "io.github.spadaval.astromech",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "astromech contributors",
    "copyright": "MIT; the speech worker is GPL-3.0 (see NOTICE.md)",
    "shortDescription": "Elite Dangerous voice copilot",
    "longDescription": "astromech: push-to-talk voice commands, keybinds and more for Elite Dangerous.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/astromech-core",
      "binaries/astromech-voice-worker"
    ],
    "resources": {
      "../../NOTICE.md": "NOTICE.md",
      "../../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../../LICENSE": "LICENSE.txt",
      "../../COPYING-GPL-3.0.txt": "COPYING-GPL-3.0.txt",
      "resources/starmap.db": "starmap.db"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
