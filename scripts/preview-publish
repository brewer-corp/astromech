#!/usr/bin/env bash
# Build the app's browser preview (the real pages, answered by app/src/preview/) into a
# folder that publishes as one claude.ai artifact: index.html plus its assets, with relative
# paths, and the page without a document wrapper (the artifact adds one). An artifact link
# carries no query string and no #/path, so the scenario and the start page are baked in.
#
# Usage: scripts/preview-publish [--core ready|new|empty] [--query 'route=exact&slow=500']
#                                [--page route] [--out dir]
# Then publish <out>/index.html with the other files listed, mapped to their own paths.
set -euo pipefail
core=ready query="" page="" out=""
need() { [[ $# -ge 2 && -n $2 ]] || { echo "scripts/preview-publish: $1 needs a value (see --help)" >&2; exit 2; }; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --core) need "$@"; core=$2; shift 2 ;;
    --query) need "$@"; query=$2; shift 2 ;;
    --page) need "$@"; page=$2; shift 2 ;;
    --out) need "$@"; out=$2; shift 2 ;;
    -h | --help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "scripts/preview-publish: unknown option $1 (see --help)" >&2; exit 2 ;;
  esac
done
case "$core" in ready | new | empty) ;; *) echo "scripts/preview-publish: --core must be ready, new or empty" >&2; exit 2 ;; esac
root=$(cd "$(dirname "$0")/.." && pwd)
out=$(realpath -m "${out:-$root/app/dist-preview}")
cd "$root/app"
VITE_PREVIEW=1 VITE_PREVIEW_QUERY="core=$core${query:+&$query}" VITE_PREVIEW_PAGE="$page" \
  pnpm -s exec vite build --base ./ --outDir "$out" --emptyOutDir --logLevel warn
python3 -I - "$out/index.html" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p, encoding="utf-8").read()
head = re.search(r"<head>(.*?)</head>", s, re.S).group(1)
body = re.search(r"<body>(.*?)</body>", s, re.S).group(1)
# The artifact's wrapper has its own charset and viewport; keep the title, styles and scripts.
head = re.sub(r"\s*<meta (charset|name=\"viewport\")[^>]*>", "", head)
# The title names the artifact.
head, n = re.subn(r"<title>[^<]*</title>", "<title>astromech preview</title>", head)
if n != 1:
    sys.exit("scripts/preview-publish: index.html has no <title> to rename")
open(p, "w", encoding="utf-8").write(head.strip() + "\n" + body.strip() + "\n")
# The artifact store refuses XML with a DTD; an SVG's DOCTYPE does nothing in a browser.
import pathlib
for svg in pathlib.Path(p).parent.rglob("*.svg"):
    t = svg.read_text(encoding="utf-8")
    svg.write_text(re.sub(r"<!DOCTYPE[^\[>]*(\[.*?\])?\s*>\s*", "", t, count=1, flags=re.S), encoding="utf-8")
PY
echo "Built $out:"
(cd "$out" && find . -type f ! -name index.html | sed 's#^\./#  #' | sort)
