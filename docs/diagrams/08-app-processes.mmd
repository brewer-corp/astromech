flowchart TB
  subgraph IN["Ways in"]
    direction LR
    START["Start menu shortcut<br/>opens the window"]
    RUN["Start with Windows<br/>--background: tray only"]
    SECOND["A second start (--route, or an old<br/>astromech-shell.exe shortcut):<br/>asks the running app, then exits"]
    CLIENT["Local control clients<br/>(scripts, the CLI)"]
  end
  subgraph APPP["astromech-core.exe: the one app (Tauri v2), runs while you play"]
    direction TB
    TRAY["Tray icon and menu<br/>Open, Pause voice, Kill switch, updates, Quit"]
    WIN["App window (Svelte + TS)<br/>built when asked for, destroyed on close"]
    CTRL["Control API<br/>127.0.0.1, token in core.json"]
    REG["Command registry<br/>(astromech-api)"]
    CORE["The core: game watch, pipeline,<br/>voice, tools, policy, input"]
  end
  WV["WebView2 processes<br/>only while the window is open"]
  WORKER["astromech-voice-worker.exe<br/>supervised: STT and TTS"]
  START -->|"starts"| TRAY
  RUN -->|"starts"| TRAY
  SECOND -->|"open_window"| CTRL
  CLIENT --> CTRL
  TRAY -->|"Open"| WIN
  WIN -->|"call, in process"| REG
  CTRL --> REG
  REG --- CORE
  WIN -.- WV
  CORE <-->|stdio| WORKER
